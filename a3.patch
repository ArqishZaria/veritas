new file mode 100644
index 0000000..e894c66
--- /dev/null
+++ b/scripts/failure_run.py
@@ -0,0 +1,43 @@
+"""D3 helper: runs the load client and, at fixed offsets, stops and restarts replica B; prints UTC timestamps so
+removal/recovery times can be read off the dashboard.
+  python scripts/failure_run.py http --rate 100 --duration 120 --stop-at 30 --start-at 75 --out results/d3-http.json"""
+import argparse
+import os
+import subprocess
+import sys
+import threading
+import time
+from datetime import datetime, timezone
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ap = argparse.ArgumentParser()
+ap.add_argument("interface", choices=["http", "grpc"])
+ap.add_argument("--rate", default="100")
+ap.add_argument("--duration", default="120")
+ap.add_argument("--stop-at", type=float, default=30)
+ap.add_argument("--start-at", type=float, default=75)
+ap.add_argument("--out", default=None)
+a = ap.parse_args()
+
+
+def stamp():
+    return datetime.now(timezone.utc).strftime("%H:%M:%S.%f")[:-3] + "Z"
+
+
+def at(offset, action):
+    time.sleep(offset)
+    print(f"[{stamp()}] docker compose {action} veritas-b", flush=True)
+    subprocess.check_call(["docker", "compose", action, "veritas-b"], cwd=ROOT)
+
+
+t0 = time.time()
+cmd = [sys.executable, os.path.join(ROOT, "scripts", "load_client.py"), a.interface, "--rate", a.rate, "--duration", a.duration,
+       "--label", f"D3 failure: stop B at +{a.stop_at}s, start at +{a.start_at}s"]
+if a.out:
+    cmd += ["--out", a.out]
+print(f"[{stamp()}] load starts")
+proc = subprocess.Popen(cmd)
+threading.Thread(target=at, args=(a.stop_at, "stop"), daemon=True).start()
+threading.Thread(target=lambda: at(a.start_at, "start"), daemon=True).start()
+proc.wait()
+print(f"[{stamp()}] load finished")
diff --git a/scripts/gen_envoy.py b/scripts/gen_envoy.py
new file mode 100644
index 0000000..876a1ef
--- /dev/null
+++ b/scripts/gen_envoy.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""Generates envoy/<scenario>.yaml (static config; Envoy has no env substitution, so one file per scenario).
+Scenarios: a-only | rr | weighted | least-request | health.   Switch with: python scripts/scenario.py <name>
+Replicas have fixed IPs on veritas-net (see docker-compose.yml) so a stopped replica stays a known, STATIC endpoint:
+removal/recovery is then decided by the active health checker only, not by Docker DNS."""
+import os
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+IPS = {"A": "172.28.0.11", "B": "172.28.0.12", "C": "172.28.0.13"}
+APP_PORT, GRPC_APP_PORT = 8000, 50051          # inside each replica container
+HTTP_LISTEN, GRPC_LISTEN = 8080, 50051          # Envoy listeners (host: 8000 and 50051)
+ALL = ["A", "B", "C"]
+SCENARIOS = {
+    "a-only":        dict(members=["A"], weights={"A": 1}, policy="ROUND_ROBIN", hc=False),
+    "rr":            dict(members=ALL, weights={"A": 1, "B": 1, "C": 1}, policy="ROUND_ROBIN", hc=False),
+    "weighted":      dict(members=ALL, weights={"A": 2, "B": 1, "C": 1}, policy="ROUND_ROBIN", hc=False),
+    "least-request": dict(members=ALL, weights={"A": 1, "B": 1, "C": 1}, policy="LEAST_REQUEST", hc=False),
+    "health":        dict(members=ALL, weights={"A": 1, "B": 1, "C": 1}, policy="ROUND_ROBIN", hc=True),
+}
+# Active health check (recorded in the report): interval 2s, timeout 1s, unhealthy 2, healthy 2.
+HC = """    health_checks:
+    - timeout: 1s
+      interval: 2s
+      interval_jitter: 0s
+      no_traffic_interval: 2s
+      unhealthy_interval: 2s
+      unhealthy_threshold: 2
+      healthy_threshold: 2
+      http_health_check: {path: /health}
+@@ALT@@"""
+
+ACCESS_LOG = """          access_log:
+          - name: envoy.access_loggers.stdout
+            typed_config:
+              "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
+              log_format:
+                json_format:
+                  "@timestamp": "%START_TIME(%Y-%m-%dT%H:%M:%S.%3fZ)%"
+                  "message": "envoy access"
+                  "service.name": "veritas-envoy"
+                  "interface": "@@IFACE@@"
+                  "trace.id": "%REQ(X-TRACE-ID)%"
+                  "replica.id": "%RESP(X-REPLICA-ID)%"
+                  "upstream.host": "%UPSTREAM_HOST%"
+                  "upstream.cluster": "%UPSTREAM_CLUSTER%"
+                  "http.request.method": "%REQ(:METHOD)%"
+                  "url.path": "%REQ(:PATH)%"
+                  "http.response.status_code": "%RESPONSE_CODE%"
+                  "grpc.status": "%GRPC_STATUS%"
+                  "envoy.duration_ms": "%DURATION%"
+                  "envoy.response_flags": "%RESPONSE_FLAGS%\""""
+
+LISTENER = """  - name: @@IFACE@@_listener
+    address:
+      socket_address: {address: 0.0.0.0, port_value: @@PORT@@}
+    filter_chains:
+    - filters:
+      - name: envoy.filters.network.http_connection_manager
+        typed_config:
+          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
+          stat_prefix: @@IFACE@@_ingress
+          codec_type: AUTO   # gRPC listener: HTTP/2 connection manager (NOT tcp_proxy) => routing is per call
+          use_remote_address: true
+@@ACCESS_LOG@@
+          route_config:
+            name: @@IFACE@@_routes
+            virtual_hosts:
+            - name: veritas
+              domains: ["*"]
+              routes:
+@@ROUTES@@
+          http_filters:
+          - name: envoy.filters.http.router
+            typed_config:
+              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
+"""
+HTTP_ROUTES = """              - match: {prefix: "/internal"}
+                direct_response: {status: 404, body: {inline_string: "not routed through the balancer"}}
+              - match: {prefix: "/"}
+                route: {cluster: http_backend, timeout: 30s}   # no retry_policy => no retries"""
+GRPC_ROUTES = """              - match: {prefix: "/veritas.exam.v1.ExamService/"}
+                route: {cluster: grpc_backend, timeout: 30s}   # no retry_policy => no retries"""
+
+CLUSTER = """  - name: @@NAME@@
+    type: STATIC
+    connect_timeout: 1s
+    lb_policy: @@POLICY@@
+@@LR@@    circuit_breakers:        # raised so high that they never trip (A3: breakers disabled during tests)
+      thresholds:
+      - priority: DEFAULT
+        max_connections: 100000
+        max_pending_requests: 100000
+        max_requests: 100000
+        max_retries: 0
+@@H2@@@@HC@@    load_assignment:
+      cluster_name: @@NAME@@
+      endpoints:
+      - lb_endpoints:
+@@ENDPOINTS@@
+"""
+H2 = """    typed_extension_protocol_options:
+      envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
+        "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
+        explicit_http_config:
+          http2_protocol_options: {}
+"""
+
+
+def cluster(name, port, sc, grpc):
+    eps = "\n".join(f"""        - endpoint:
+            address:
+              socket_address: {{address: {IPS[r]}, port_value: {port}}}
+          load_balancing_weight: {sc['weights'][r]}""" for r in sc["members"])
+    hc = ""
+    if sc["hc"]:
+        # gRPC replicas share one process with the HTTP server, so /health on the HTTP port (alt_port) covers both.
+        hc = HC.replace("@@ALT@@", f"      alt_port: {APP_PORT}\n" if grpc else "").rstrip("\n") + "\n"
+    lr = "    least_request_lb_config: {choice_count: 3}   # look at all 3 replicas, pick the one with fewest active requests\n" \
+        if sc["policy"] == "LEAST_REQUEST" else ""
+    return (CLUSTER.replace("@@NAME@@", name).replace("@@POLICY@@", sc["policy"]).replace("@@LR@@", lr)
+            .replace("@@H2@@", H2 if grpc else "").replace("@@HC@@", hc).replace("@@ENDPOINTS@@", eps))
+
+
+def render(sc_name):
+    sc = SCENARIOS[sc_name]
+    out = f"# GENERATED by scripts/gen_envoy.py -- scenario: {sc_name}. Do not edit by hand.\n"
+    out += "admin:\n  address:\n    socket_address: {address: 0.0.0.0, port_value: 9901}\n\nstatic_resources:\n  listeners:\n"
+    for iface, port, routes in (("http", HTTP_LISTEN, HTTP_ROUTES), ("grpc", GRPC_LISTEN, GRPC_ROUTES)):
+        out += (LISTENER.replace("@@ACCESS_LOG@@", ACCESS_LOG).replace("@@IFACE@@", iface)
+                .replace("@@PORT@@", str(port)).replace("@@ROUTES@@", routes))
+    out += "  clusters:\n"
+    out += cluster("http_backend", APP_PORT, sc, grpc=False)
+    out += cluster("grpc_backend", GRPC_APP_PORT, sc, grpc=True)
+    return out
+
+
+if __name__ == "__main__":
+    for name in SCENARIOS:
+        with open(os.path.join(ROOT, "envoy", f"{name}.yaml"), "w") as f:
+            f.write(render(name))
+        print("wrote envoy/%s.yaml" % name)
diff --git a/scripts/load_client.py b/scripts/load_client.py
new file mode 100644
index 0000000..be36617
--- /dev/null
+++ b/scripts/load_client.py
@@ -0,0 +1,142 @@
+"""Fixed-rate, OPEN-LOOP load client (A3): requests are sent on a schedule (i / rate seconds after start) and
+never wait for earlier responses, so a slow replica cannot slow the sending down. No retries, no circuit breaker.
+
+  HTTP: GET  /api/v1/quizzes/{quiz_id}          python scripts/load_client.py http --rate 100 --duration 120
+  gRPC: ExamService/GetQuiz (ONE connection)    python scripts/load_client.py grpc --rate 100 --duration 120
+Every request carries a fresh 32-hex trace id; the serving replica is read from X-Replica-Id / x-replica-id."""
+import _common  # noqa: F401
+import argparse
+import asyncio
+import collections
+import json
+import math
+import os
+import time
+import uuid
+
+import grpc
+import httpx
+
+from veritas.exam.v1 import exam_pb2, exam_pb2_grpc
+
+
+def pct(vals, p):
+    if not vals:
+        return None
+    v = sorted(vals)
+    return v[max(0, math.ceil(p / 100 * len(v)) - 1)]
+
+
+class Recorder:
+    def __init__(self):
+        self.ok_lat, self.all_lat = [], []
+        self.outcomes, self.replicas = collections.Counter(), collections.Counter()
+        self.sample_trace = {}
+        self.failed = 0
+        self.max_lag = 0.0
+
+    def add(self, trace_id, latency, outcome, replica, ok):
+        self.all_lat.append(latency)
+        self.outcomes[outcome] += 1
+        if ok:
+            self.ok_lat.append(latency)
+            self.replicas[replica] += 1
+            self.sample_trace.setdefault(replica, trace_id)
+        else:
+            self.failed += 1
+            self.sample_trace.setdefault("failed", trace_id)
+
+
+async def fire(a, one):
+    """Open loop: schedule request i at start + i/rate; late iterations are sent immediately (lag is recorded)."""
+    total = int(a.rate * a.duration)
+    start, tasks, lag = time.perf_counter(), [], 0.0
+    for i in range(total):
+        wait = start + i / a.rate - time.perf_counter()
+        if wait > 0:
+            await asyncio.sleep(wait)
+        else:
+            lag = max(lag, -wait)
+        tasks.append(asyncio.create_task(one()))
+    send_elapsed = time.perf_counter() - start
+    await asyncio.gather(*tasks)
+    return total, send_elapsed, lag
+
+
+def md_get(md, key):
+    for k, v in (md or ()):
+        if k == key:
+            return v
+    return "?"
+
+
+async def run_http(a, rec):
+    limits = httpx.Limits(max_connections=2000, max_keepalive_connections=200)
+    async with httpx.AsyncClient(base_url=a.url, timeout=a.timeout, limits=limits) as c:
+        async def one():
+            tid, t0 = uuid.uuid4().hex, time.perf_counter()
+            try:
+                r = await c.get(f"/api/v1/quizzes/{a.quiz_id}", headers={"X-Trace-Id": tid})
+                rec.add(tid, time.perf_counter() - t0, f"HTTP {r.status_code}",
+                        r.headers.get("x-replica-id", "?"), r.status_code == 200)
+            except Exception as e:  # timeouts / connection errors count as failures
+                rec.add(tid, time.perf_counter() - t0, type(e).__name__, "none", False)
+        return await fire(a, one)
+
+
+async def run_grpc(a, rec):
+    async with grpc.aio.insecure_channel(a.target) as ch:   # ONE connection for every call
+        stub = exam_pb2_grpc.ExamServiceStub(ch)
+
+        async def one():
+            tid, t0 = uuid.uuid4().hex, time.perf_counter()
+            call = stub.GetQuiz(exam_pb2.GetQuizRequest(quiz_id=a.quiz_id), timeout=a.timeout,
+                                metadata=(("x-trace-id", tid),))
+            try:
+                await call
+                rec.add(tid, time.perf_counter() - t0, "OK", md_get(await call.initial_metadata(), "x-replica-id"), True)
+            except grpc.aio.AioRpcError as e:
+                rec.add(tid, time.perf_counter() - t0, e.code().name, md_get(e.initial_metadata(), "x-replica-id"), False)
+            except Exception as e:
+                rec.add(tid, time.perf_counter() - t0, type(e).__name__, "none", False)
+        return await fire(a, one)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("interface", choices=["http", "grpc"])
+    ap.add_argument("--url", default="http://localhost:8000", help="HTTP base URL (Envoy listener)")
+    ap.add_argument("--target", default="localhost:50051", help="gRPC target (Envoy listener)")
+    ap.add_argument("--rate", type=float, default=100, help="target requests per second")
+    ap.add_argument("--duration", type=float, default=60, help="seconds of sending")
+    ap.add_argument("--timeout", type=float, default=5, help="per-request timeout, seconds")
+    ap.add_argument("--quiz-id", default="python_101")
+    ap.add_argument("--label", default="", help="free text stored in the JSON result (e.g. 'D2 least-request, B+200ms')")
+    ap.add_argument("--out", help="write the result as JSON (e.g. results/c-rr-http.json)")
+    a = ap.parse_args()
+    rec = Recorder()
+    t_start = time.time()
+    sent, send_elapsed, lag = asyncio.run((run_http if a.interface == "http" else run_grpc)(a, rec))
+    ok = len(rec.ok_lat)
+    res = {"label": a.label, "interface": a.interface, "started_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t_start)),
+           "target_rps": a.rate, "duration_s": a.duration, "sent": sent, "achieved_send_rps": round(sent / send_elapsed, 2),
+           "max_send_lag_ms": round(lag * 1000, 1), "success": ok, "failed": rec.failed,
+           "error_rate_pct": round(100 * rec.failed / sent, 2) if sent else 0.0,
+           "client_p50_ms": round(pct(rec.ok_lat, 50) * 1000, 1) if ok else None,
+           "client_p95_ms": round(pct(rec.ok_lat, 95) * 1000, 1) if ok else None,
+           "client_p99_ms": round(pct(rec.ok_lat, 99) * 1000, 1) if ok else None,
+           "client_p95_all_ms": round(pct(rec.all_lat, 95) * 1000, 1) if rec.all_lat else None,
+           "outcomes": dict(rec.outcomes),
+           "replica_counts": dict(rec.replicas),
+           "replica_share_pct": {k: round(100 * v / ok, 1) for k, v in sorted(rec.replicas.items())} if ok else {},
+           "sample_trace_ids": rec.sample_trace}
+    print(json.dumps(res, indent=2))
+    if a.out:
+        os.makedirs(os.path.dirname(a.out) or ".", exist_ok=True)
+        with open(a.out, "w") as f:
+            json.dump(res, f, indent=2)
+        print("wrote", a.out)
+
+
+if __name__ == "__main__":
+    main()
