  "components": {
    "schemas": {
      "AdminAttemptRow": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "quiz_title": {
            "type": "string",
            "title": "Quiz Title"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "cheated"
            ],
            "title": "Status"
          },
          "tab_switch_count": {
            "type": "integer",
            "title": "Tab Switch Count"
          },
          "submitted_at": {
            "type": "string",
            "title": "Submitted At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "quiz_title",
          "score",
          "status",
          "tab_switch_count",
          "submitted_at"
        ],
        "title": "AdminAttemptRow"
      },
      "AdminAttemptsOut": {
        "properties": {
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/AdminAttemptRow"
            },
            "type": "array",
            "title": "Attempts"
          }
        },
        "type": "object",
        "required": [
          "attempts"
        ],
        "title": "AdminAttemptsOut"
      },
      "AdminCreateQuizRequest": {
        "properties": {
          "admin_id": {
            "type": "string",
            "minLength": 1,
            "title": "Admin Id"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "topic": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Topic"
          },
          "duration_seconds": {
            "type": "integer",
            "maximum": 7200.0,
            "minimum": 30.0,
            "title": "Duration Seconds",
            "default": 180
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/AdminQuizQuestion"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "admin_id",
          "title",
          "topic",
          "questions"
        ],
        "title": "AdminCreateQuizRequest"
      },
      "AdminQuiz": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "topic": {
            "type": "string",
