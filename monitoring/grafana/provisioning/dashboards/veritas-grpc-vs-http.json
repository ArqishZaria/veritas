    {
      "id": 2,
      "type": "timeseries",
      "title": "gRPC calls/s by method & status code",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "veritas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (grpc_method, grpc_code) (rate(veritas_grpc_server_handled_total[1m]))",
          "legendFormat": "{{grpc_method}} {{grpc_code}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "veritas-prometheus"
          }
